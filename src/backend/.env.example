# Development/evaluation only. Evidence authorization is intentionally deferred.
# Set these as environment variables; the service does not auto-load this file.
CRV_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
CRV_SEARCH_INDEX=crv-evidence-v1
CRV_SEARCH_RELEASE=crv-v1
CRV_KG_RELEASE=YOUR-PINNED-KG-RELEASE
CRV_POSTGRES_HOST=YOUR-POSTGRES.postgres.database.azure.com
CRV_POSTGRES_ROOT_CERT=system
CRV_KG_DATABASE=ingestion-catalog
CRV_POSTGRES_USER=YOUR-KG-READER
CRV_MEMORY_DATABASE=crv-agent-memory
CRV_MEMORY_USER=YOUR-MEMORY-RUNTIME-LOGIN
CRV_OPENAI_ENDPOINT=https://YOUR-FOUNDRY.openai.azure.com
CRV_PLANNER_DEPLOYMENT=YOUR-PLANNER
CRV_WORKER_DEPLOYMENT=YOUR-WORKER
CRV_ANSWER_DEPLOYMENT=YOUR-ANSWER
CRV_VERIFIER_DEPLOYMENT=YOUR-VERIFIER
# Per-role reasoning effort (none|minimal|low|medium|high|xhigh); unset = deployment default.
# CRV_PLANNER_REASONING_EFFORT=
# CRV_WORKER_REASONING_EFFORT=
# CRV_ANSWER_REASONING_EFFORT=
# CRV_VERIFIER_REASONING_EFFORT=
CRV_TENANT_ID=YOUR-TENANT-ID
CRV_AUDIENCE=YOUR-API-AUDIENCE
# Provider-reported tokens per turn (default 300000); deep evidence reading needs headroom.
# CRV_TURN_TOKENS=300000
# CRV_TURN_SECONDS=120
# Worker: extract (bounded retrieve-then-extract, default) or agent (tool-calling loop).
# CRV_WORKER_MODE=extract
# CRV_FACET_CONCURRENCY=4
# CRV_WORKER_OUTPUT_TOKENS=8192
# CRV_MODEL_RETRIES=4
# Evidence exposure per facet. Default = measured winner (50 full chunks); see
# Docs/evaluation/agent-retrieval-depth-2026-10-21.md:
# CRV_EVIDENCE_PACK_SIZE=50
# CRV_EVIDENCE_EXCERPT_CHARACTERS=8000
# CRV_EVIDENCE_ANCHOR=lexical        # or caption (semantic extractive captions)
# CRV_EVIDENCE_RERANK=none           # or llm (listwise rerank with the worker deployment)
# For explicit loopback-only development instead of Entra:
# CRV_LOCAL_OWNER=local-developer
# Evaluation only (requires CRV_LOCAL_OWNER): stream the claim ledger and exposed passages.
# CRV_EVAL_DIAGNOSTICS=false
