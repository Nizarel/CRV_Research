  "tokenizers": [
    {
      "@odata.type": "#Microsoft.Azure.Search.PatternTokenizer",
      "name": "identifier_query_tokenizer",
      "pattern": "[\\s,;:!?()\\[\\]{}<>\"'«»]+|\\.(?=\\s|$)"
    }
  ],
  "analyzers": [
    {
      "@odata.type": "#Microsoft.Azure.Search.CustomAnalyzer",
      "name": "identifier_index",
      "tokenizer": "keyword_v2",
      "tokenFilters": ["lowercase", "asciifolding"]
    },
    {
      "@odata.type": "#Microsoft.Azure.Search.CustomAnalyzer",
      "name": "identifier_query",
      "tokenizer": "identifier_query_tokenizer",
      "tokenFilters": ["lowercase", "asciifolding"]
    }
  ],
  "similarity": {"@odata.type": "#Microsoft.Azure.Search.BM25Similarity"},
  "vectorSearch": {
    "algorithms": [
      {"name": "evidence-hnsw", "kind": "hnsw", "hnswParameters": {"metric": "cosine", "m": 4, "efConstruction": 400, "efSearch": 500}}
    ],
    "compressions": [
      {
        "name": "evidence-int8",
        "kind": "scalarQuantization",
        "scalarQuantizationParameters": {"quantizedDataType": "int8"},
        "rescoringOptions": {"enableRescoring": true, "defaultOversampling": 4, "rescoreStorageMethod": "preserveOriginals"}
      }
    ],
    "vectorizers": [
