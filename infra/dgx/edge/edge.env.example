# CRV edge backend settings (no secrets). Copy to /srv/crv-secure/secrets/edge.env (0600), edit.
# compose.yaml fixes the database host, logins, password-file paths and the source root.
# Every value below is a starting point to confirm in Docs/DGX_EDGE_PLACEMENT.md.

# Interim identity: one shared local owner; keep CRV_EDGE_BIND on loopback or a restricted LAN.
CRV_LOCAL_OWNER=crv-edge
CRV_EVAL_DIAGNOSTICS=false
CRV_KG_RELEASE=REPLACE_PINNED_KG_RELEASE
CRV_SEARCH_RELEASE=crv-v1

# PostgreSQL on the private Docker network: password auth, TLS off on that network only.
CRV_POSTGRES_SSLMODE=disable

# Retrieval in crv_retrieval with BGE-M3 vectors (after retrieval-embed and retrieval-index m3).
# The retrieval model servers are containers on the crv-edge_models network, named as below.
CRV_SEARCH_BACKEND=postgres
CRV_PG_VECTOR_MODEL=m3
CRV_PG_EMBEDDER=openai
CRV_PG_EMBEDDING_URL=http://crv-bge-m3:8000/v1
CRV_PG_EMBEDDING_MODEL=bge-m3
# Local cross-encoder, once crv-reranker runs (the hosted NVIDIA rerankers reached end of life):
CRV_PG_RERANKER=none
# CRV_PG_RERANKER=vllm
# CRV_PG_RERANKER_URL=http://crv-reranker:8000/v1/rerank
# CRV_PG_RERANKER_MODEL=bge-reranker-v2-m3
CRV_PRIVATE_HTTP_HOSTS=["crv-bge-m3","crv-reranker","dgx-niz02"]

# Phase 1 generation: NVIDIA API catalog. The key file lives in /srv/crv-secure/secrets (0600).
# Measured 2026-10-29 (Docs/DGX_EDGE_VALIDATION.md, progress): bolt in every role gave the first
# verified answers on 10 golden dev questions with no turn timeouts. lightning with reasoning off
# routed most research questions to catalogue or clarify as planner, returned drafts without
# claim numbers as composer, and its hosted latency spikes exceeded the 120 s turn budget.
# openai/gpt-oss-20b returned empty structured output in 30-45% of calls at any reasoning effort.
CRV_MODEL_ENDPOINT=https://integrate.api.nvidia.com/v1
CRV_MODEL_AUTH=key
CRV_MODEL_API_KEY_FILE=/run/crv-secrets/nvidia-api.key
CRV_PLANNER_DEPLOYMENT=nvidia/nemotron-3.5-bolt-e4b
CRV_WORKER_DEPLOYMENT=nvidia/nemotron-3.5-bolt-e4b
CRV_ANSWER_DEPLOYMENT=nvidia/nemotron-3.5-bolt-e4b
CRV_VERIFIER_DEPLOYMENT=nvidia/nemotron-3.5-bolt-e4b
# Four parallel extraction calls per facet: bolt returns more claims with smaller batches.
CRV_EXTRACT_BATCHES=4
# Phase 2 (local vLLM on dgx-niz02 over the direct link): CRV_MODEL_ENDPOINT=
# http://dgx-niz02:8000/v1 with CRV_NIZ02_ADDRESS=192.168.100.11, the key file
# /run/crv-secrets/niz02-vllm.key and the served model names.
CRV_PLANNER_REASONING_EFFORT=
CRV_WORKER_REASONING_EFFORT=
CRV_ANSWER_REASONING_EFFORT=
CRV_VERIFIER_REASONING_EFFORT=
